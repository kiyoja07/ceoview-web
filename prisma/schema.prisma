  identificationNumber String?   @map("주민등록번호") @db.VarChar(20)
  address              String?   @map("주 소") @db.VarChar(255)
  phone                String?   @map("전화번호") @db.VarChar(30)
  joinDate             DateTime? @map("입사일") @db.Date

  workDays      Int?     @map("근무일수")
  normalHours   Decimal? @map("근무시간_정상") @db.Decimal(10, 2)
  overtimeHours Decimal? @map("근무시간_연장") @db.Decimal(10, 2)

