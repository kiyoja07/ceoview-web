model CompanyChangeRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  scope  CompanyChangeRequestScope
  action CompanyChangeRequestAction
  status CompanyChangeRequestStatus @default(PENDING)

  companyId String @db.ObjectId  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedByCompanyUserId String @db.ObjectId      @map("requested_by_company_user_id")
  requestedByCompanyUser   CompanyUser @relation("RequestedByCompanyUser", fields: [requestedByCompanyUserId], references: [id], onDelete: Cascade)

  resolvedByAgentUserId String? @db.ObjectId    @map("resolved_by_agent_user_id")
  resolvedByAgentUser   AgentUser? @relation("ResolvedByAgentUser", fields: [resolvedByAgentUserId], references: [id], onDelete: SetNull)

  targetEmployeeId String? @db.ObjectId @map("target_employee_id")

  requestedPayload Json  @map("requested_payload")
  currentSnapshot  Json? @map("current_snapshot")

  resolutionComment String?   @map("resolution_comment")
  resolvedAt        DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, status, scope, createdAt])
  @@index([requestedByCompanyUserId, status, createdAt])
  @@index([resolvedByAgentUserId, status, createdAt])
  @@index([targetEmployeeId, status, createdAt])
  @@map("company_change_request")
}
