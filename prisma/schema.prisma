/**
 * ---------------------------
 * 직원 관리
 * ---------------------------
 */

model Employee {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyId BigInt  @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeCode    String? @map("employee_code") @db.VarChar(50)
  name            String  @db.VarChar(100)
  residentNumber  String? @map("resident_number") @db.VarChar(20)
  nationalityType String? @map("nationality_type") @db.VarChar(20) // 내·외국인
  jobCategory     String? @map("job_category") @db.VarChar(50) // 직종구분
  residenceType   String? @map("residence_type") @db.VarChar(20) // 거주구분
  department      String? @map("department") @db.VarChar(50) // 부서
  positionTitle   String? @map("position_title") @db.VarChar(50) // 직책명
  email           String? @db.VarChar(255)
  phone           String? @db.VarChar(30) // 휴대폰
  landlinePhone   String? @map("landline_phone") @db.VarChar(30) // 전화번호
  hireDate        String? @map("hire_date") @db.VarChar(10)
  resignDate      String? @map("resign_date") @db.VarChar(10)
  zipcode         String? @map("zipcode") @db.VarChar(10)
  address         String? @map("address") @db.VarChar(255)
  addressDetail   String? @map("address_detail") @db.VarChar(255)

  // 부양가족 공제
  hasSpouse        String? @map("has_spouse") @db.VarChar(10) // 배우자 유무
  dependentUnder20 String? @map("dependent_under_20") @db.VarChar(10) // 부양가족공제_20세이하
  dependentOver60  String? @map("dependent_over_60") @db.VarChar(10) // 부양가족공제_60세이상

  // 추가 공제
  deductionSenior        String? @map("deduction_senior") @db.VarChar(10) // 추가공제_경로우대
  deductionDisabled      String? @map("deduction_disabled") @db.VarChar(10) // 추가공제_장애인
  deductionWomen         String? @map("deduction_women") @db.VarChar(10) // 추가공제_부녀자
  deductionChildren      String? @map("deduction_children") @db.VarChar(10) // 추가공제_자녀
  deductionBirthAdoption String? @map("deduction_birth_adoption") @db.VarChar(10) // 추가공제_출산입양
  deductionSingleParent  String? @map("deduction_single_parent") @db.VarChar(10) // 추가공제_한부모

  // 보험/호봉
  employmentInsurance String? @map("employment_insurance") @db.VarChar(20) // 고용보험
  payGrade            String? @map("pay_grade") @db.VarChar(20) // 호봉
  nationalPension     String? @map("national_pension") @db.VarChar(20) // 국민연금
  healthInsurance     String? @map("health_insurance") @db.VarChar(20) // 건강보험

  publishStatus EmployeePublishStatus @default(SAVED) @map("publish_status")

  bankAccounts  EmployeeBankAccount[]
  earnedIncomes EarnedIncome[]
  user          EmployeeUser?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([companyId, employeeCode])
  @@index([companyId, name])
  @@index([companyId, deletedAt, createdAt])
  @@index([companyId, publishStatus, deletedAt])
  @@map("employee")
}

model EmployeeUser {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  employeeId BigInt   @unique @map("employee_id") @db.UnsignedBigInt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  email String? @unique @db.VarChar(255)
  phone String? @unique @db.VarChar(30)
  name          String  @db.VarChar(100)
  zipcode       String? @map("zipcode") @db.VarChar(10)
  address       String? @map("address") @db.VarChar(255)
  addressDetail String? @map("address_detail") @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  magicLinkTokens EmployeeMagicLinkToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("employee_user")
}

model EmployeeMagicLinkToken {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  employeeUserId BigInt       @map("employee_user_id") @db.UnsignedBigInt
  employeeUser   EmployeeUser @relation(fields: [employeeUserId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employeeUserId, expiresAt])
  @@index([expiresAt])
  @@map("employee_magic_link_token")
}

