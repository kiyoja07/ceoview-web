// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  INDIVIDUAL
  CORPORATION
}

enum PayrollItemKind {
  PAYMENT
  DEDUCTION
}

enum CustomerLinkStatus {
  ACTIVE
  INACTIVE
}

enum LoginProvider {
  LOCAL
  GOOGLE
  KAKAO
  NAVER
  APPLE
}

enum UploadType {
  EARNED_INCOME // 근로소득
  BUSINESS_INCOME // 사업소득
  OTHER_INCOME // 기타소득
  OTHER_INCOME_LABOR // 일용소득
}

enum EmployeePublishStatus {
  SAVED
  PUBLISHED
}

enum AgentBillingPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum CompanyJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

//  세무사무소 등 에이전트 회사 : 서비스 제공자
model AgentOrganization {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationNumber String @unique @map("organization_number") // 숫자만 10자리 저장

  businessType BusinessType @map("business_type") // 개인/법인 구분

  organizationName   String?   @map("organization_name") // 에이전트 회사명
  representativeName String?   @map("representative_name") // 대표자명
  phone              String?   @map("phone")
  openingDate        DateTime? @map("opening_date")
  zipcode            String?   @map("zipcode")
  address            String?   @map("address")
  addressDetail      String?   @map("address_detail")

  users                AgentUser[]
  billing              AgentOrganizationBilling?
  inviteTokens         AgentUserInviteToken[]
  companyLinks         AgentOrganizationCompany[]
  accountCatalogs      AccountCatalog[]
  financialReports     FinancialReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_organization")
}

// 에이전트의 고객 회사 : 서비스 수혜자
model Company {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessNumber String @unique @map("business_number") // 숫자만 10자리 저장

  businessType BusinessType @map("business_type") // 개인/법인 구분

  businessName       String?   @map("business_name") // 사업자명
  representativeName String?   @map("representative_name") // 대표자명
  openingDate        DateTime? @map("opening_date")
  zipcode            String?   @map("zipcode")
  address            String?   @map("address")
  addressDetail      String?   @map("address_detail")

  isDemo           Boolean @default(false) @map("is_demo") // 데모 계정 여부
  isPublicShowcase Boolean @default(false) @map("is_public_showcase") // 공개 쇼케이스 여부
  publicSlug       String? @unique @map("public_slug") // 공개 URL 슬러그

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  uploads                     Upload[]
  activeUploads               CompanyActiveUpload[]
  earnedIncomeItemDefinitions EarnedIncomeItemDefinition[]
  companyUsers                CompanyUser[]
  companyMemberships          CompanyUserCompany[]
  companyUserInviteHistories  CompanyUserInviteHistory[]
  joinRequests                CompanyJoinRequest[]
  employees                   Employee[]
  businessIncomeEmployees     BusinessIncomeEmployee[]
  otherIncomeEmployees        OtherIncomeEmployee[]
  otherIncomeLaborEmployees   OtherIncomeLaborEmployee[]
  organizationLink            AgentOrganizationCompany?
  financialReports            FinancialReport[]
  activeFinancialReport       CompanyActiveFinancialReport?

  @@map("company")
}

// 에이전트 회사와 고객 회사의 연결 테이블 : many-to-many 관계
model AgentOrganizationCompany {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  agentOrganizationId String            @map("agent_organization_id") @db.ObjectId
  agentOrganization   AgentOrganization @relation(fields: [agentOrganizationId], references: [id], onDelete: Cascade)

  companyId String  @unique @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // 에이전트가 거래처에 선택적으로 제공하는 기능 스위치
  salaryFeatureEnabled          Boolean @default(true) @map("salary_feature_enabled") // 인건비/직원 관리
  financialReportFeatureEnabled Boolean @default(true) @map("financial_report_feature_enabled") // 재무리포트

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([agentOrganizationId, companyId])
  @@map("agent_organization_company")
}

// 에이전트 회사 소속 사용자
model AgentUser {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  agentOrganizationId String?            @map("agent_organization_id") @db.ObjectId
  agentOrganization   AgentOrganization? @relation(fields: [agentOrganizationId], references: [id])

  email          String        @unique
  passwordHash   String?       @map("password_hash")
  loginProvider  LoginProvider @default(LOCAL) @map("login_provider")
  providerUserId String?       @map("provider_user_id")
  name           String
  phone          String?
  isMaster       Boolean       @default(false) @map("is_master")
  isActive       Boolean       @default(true) @map("is_active")

  customerLinks          AgentCompanyCustomer[]
  magicLinkTokens        AgentMagicLinkToken[]
  phoneVerificationCodes AgentPhoneVerificationCode[]
  sentInviteTokens       AgentUserInviteToken[]                    @relation("InviterUserInviteTokens")
  sentCompanyUserInvites CompanyUserInviteHistory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loginProvider, providerUserId])
  @@index([agentOrganizationId, isActive])
  @@map("agent_user")
}

// 에이전트 사용자용 매직링크 토큰
model AgentMagicLinkToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  agentUserId String    @map("agent_user_id") @db.ObjectId
  agentUser   AgentUser @relation(fields: [agentUserId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentUserId, expiresAt])
  @@index([expiresAt])
  @@map("agent_magic_link_token")
}

// 에이전트 사용자 초대 토큰 (이메일 기반)
model AgentUserInviteToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  agentOrganizationId String            @map("agent_organization_id") @db.ObjectId
  agentOrganization   AgentOrganization @relation(fields: [agentOrganizationId], references: [id], onDelete: Cascade)

  inviterUserId String    @map("inviter_user_id") @db.ObjectId
  inviterUser   AgentUser @relation("InviterUserInviteTokens", fields: [inviterUserId], references: [id], onDelete: Cascade)

  invitedEmail String @map("invited_email")

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  acceptedAgentUserId String? @map("accepted_agent_user_id") @db.ObjectId

  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentOrganizationId, invitedEmail, expiresAt])
  @@index([inviterUserId, createdAt])
  @@index([expiresAt])
  @@map("agent_user_invite_token")
}

// 고객 회사 소속 사용자
model CompanyUser {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  email          String        @unique
  passwordHash   String?       @map("password_hash")
  loginProvider  LoginProvider @default(LOCAL) @map("login_provider")
  providerUserId String?       @map("provider_user_id")
  name           String
  phone          String?
  birthday       DateTime?     @map("birthday")
  gender         String?       @map("gender")
  isMaster       Boolean       @default(false) @map("is_master")
  isActive       Boolean       @default(true) @map("is_active")

  agentLinks             AgentCompanyCustomer[]
  magicLinkTokens        CompanyMagicLinkToken[]
  phoneVerificationCodes PhoneVerificationCode[]
  companyMemberships     CompanyUserCompany[]
  joinRequests           CompanyJoinRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loginProvider, providerUserId])
  @@index([companyId])
  @@map("company_user")
}

// 고객 회사 사용자와 고객 회사의 연결 테이블 : many-to-many 관계
// 회사 사용자가 여러 회사에 소속될 수 있는 경우를 대비한 연결 테이블
model CompanyUserCompany {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyUserId String      @map("company_user_id") @db.ObjectId
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyUserId, companyId])
  @@index([companyId])
  @@map("company_user_company")
}

// 초대 링크 없이 직접 가입한 회사 사용자의 기존 사업장 가입 요청
model CompanyJoinRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companyUserId String      @map("company_user_id") @db.ObjectId
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  businessNumber String                   @map("business_number")
  status         CompanyJoinRequestStatus @default(PENDING)

  requestedAt DateTime  @default(now()) @map("requested_at")
  resolvedAt  DateTime? @map("resolved_at")

  // "agent" | "company"
  resolvedByType String? @map("resolved_by_type")
  resolvedById   String? @map("resolved_by_id") @db.ObjectId

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, companyUserId])
  @@index([companyId, status, requestedAt])
  @@index([companyUserId, status])
  @@map("company_join_request")
}

// 고객 회사 사용자용 매직링크 토큰
model CompanyMagicLinkToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyUserId String      @map("company_user_id") @db.ObjectId
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyUserId, expiresAt])
  @@index([expiresAt])
  @@map("company_magic_link_token")
}

// 에이전트 사용자 휴대폰 인증 코드
model AgentPhoneVerificationCode {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  agentUserId String    @map("agent_user_id") @db.ObjectId
  agentUser   AgentUser @relation(fields: [agentUserId], references: [id], onDelete: Cascade)

  phone      String
  code       String
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentUserId, phone, expiresAt])
  @@index([expiresAt])
  @@map("agent_phone_verification_code")
}

//  휴대폰 인증 코드
model PhoneVerificationCode {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyUserId String      @map("company_user_id") @db.ObjectId
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  phone      String
  code       String
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyUserId, phone, expiresAt])
  @@index([expiresAt])
  @@map("phone_verification_code")
}

// 거래처 사용자 초대 이력
model CompanyUserInviteHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inviterAgentUserId String    @map("inviter_agent_user_id") @db.ObjectId
  inviterAgentUser   AgentUser @relation(fields: [inviterAgentUserId], references: [id], onDelete: Cascade)

  contactType String @map("contact_type") // "email" | "phone"
  contact     String
  role        String @default("master")

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([inviterAgentUserId])
  @@map("company_user_invite_history")
}

// 고객사와 에이전트사의 연결 테이블 : many-to-many 관계
// 에이전트사가 고객사에 대한 세무대리인 역할을 수행하는 경우를 나타내는 연결 테이블
model AgentCompanyCustomer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  agentUserId String    @map("agent_user_id") @db.ObjectId
  agentUser   AgentUser @relation(fields: [agentUserId], references: [id])

  companyUserId String      @map("company_user_id") @db.ObjectId
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id])

  status          CustomerLinkStatus @default(ACTIVE)
  contractStartAt DateTime?          @map("contract_start_at")
  contractEndAt   DateTime?          @map("contract_end_at")
  memo            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([agentUserId, companyUserId])
  @@index([companyUserId, status])
  @@map("agent_company_customer")
}

model AgentOrganizationBilling {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  agentOrganizationId String            @unique @map("agent_organization_id") @db.ObjectId
  agentOrganization   AgentOrganization @relation(fields: [agentOrganizationId], references: [id])

  plan AgentBillingPlan @default(STARTER) @map("plan")

  cardBrand        String?   @map("card_brand")
  cardLast4        String?   @map("card_last4")
  cardExpMonth     Int?      @map("card_exp_month")
  cardExpYear      Int?      @map("card_exp_year")
  cardHolderName   String?   @map("card_holder_name")
  billingKey       String?   @map("billing_key")
  cardRegisteredAt DateTime? @map("card_registered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_organization_billing")
}

/**
 * ---------------------------
 * 위하고 엑셀 파일 관련 테이블
 * ---------------------------
 */

model Upload {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  type UploadType @map("type")

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  fileName   String?  @map("file_name")
  checksum   String?  @map("checksum")
  memo       String?  @map("memo")

  // row relations (타입별 row 테이블)
  earnedRows     EarnedIncome[]
  businessRows   BusinessIncome[]
  otherRows      OtherIncome[]
  dailyLaborRows DailyIncomeLabor[]

  activePointer CompanyActiveUpload?

  // 동일 파일 중복 업로드 감지(선택): 같은 사업자+타입+체크섬은 중복 방지 가능
  @@unique([companyId, type, checksum])
  // 조회 최적화
  @@index([companyId, type, uploadedAt])
  @@map("upload")
}

// "현재 적용 배치"를 강제하는 포인터 테이블
// 사업자+타입당 1개만 존재하도록 UNIQUE로 강제됨
model CompanyActiveUpload {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  type UploadType @map("type")

  uploadId String @unique @db.ObjectId
  upload   Upload @relation(fields: [uploadId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([companyId, type])
  @@map("workplace_active_upload")
}

/**
 * ---------------------------
 * 근로소득
 * ---------------------------
 */

model EarnedIncome {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  uploadId String @db.ObjectId
  upload   Upload @relation(fields: [uploadId], references: [id])

  accrualYm Int      @map("귀속년월")
  paymentYm Int      @map("지급년월")
  payDate   DateTime @map("지급일")

  employeeId String?   @map("employee_id") @db.ObjectId
  employee   Employee? @relation(fields: [employeeId], references: [id])

  employeeCode String  @map("사원코드")
  employeeName String  @map("사원명")
  department   String? @map("부서")
  position     String? @map("직급")
  jobType      String? @map("직종")

  baseSalary    Float @map("수당_기본급")
  bonus         Float @map("상여")
  mealAllowance Float @map("식대")
  allowance     Float @map("수당")
  travelExpense Float @map("출장비")
  totalPayment  Float @map("지급액계")

  nationalPensionDeduction Float @map("공제_국민연금")
  healthInsurance          Float @map("건강보험")
  employmentInsurance      Float @map("고용보험")
  longTermCareInsurance    Float @map("장기요양보험료")
  incomeTax                Float @map("소득세")
  localIncomeTax           Float @map("지방소득세")
  healthInsuranceAdj       Float @map("건강보험정산")
  nationalPensionAdj       Float @map("국민연금정산")
  employmentInsuranceAdj   Float @map("고용보험정산")
  longTermCareAdj          Float @map("장기요양정산")
  prepaidIncomeTax         Float @map("기납부소득세")
  prepaidLocalIncomeTax    Float @map("기납부지방소득세")
  addlIncomeTaxAdj         Float @map("추가정산소득세")
  addlLocalIncomeTaxAdj    Float @map("추가정산지방소득세")
  totalDeduction           Float @map("공제액계")

  netPayment Float @map("차인지급액")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemValues           EarnedIncomeItemValue[]
  payslipNotifications PayslipNotification[]
  payslipAccessTokens  PayslipAccessToken[]

  @@unique([uploadId, employeeCode, accrualYm, paymentYm, payDate])
  @@index([employeeCode, accrualYm, paymentYm, payDate])
  @@index([employeeId])
  @@map("earned_income")
}

enum PayslipChannel {
  EMAIL
  SMS
  KAKAO
}

enum PayslipNotificationStatus {
  SENT
  FAILED
}

model PayslipNotification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  earnedIncomeId String       @map("earned_income_id") @db.ObjectId
  earnedIncome   EarnedIncome @relation(fields: [earnedIncomeId], references: [id], onDelete: Cascade)

  channel      PayslipChannel
  recipient    String
  status       PayslipNotificationStatus @default(SENT)
  errorMessage String?                   @map("error_message")
  sentAt       DateTime                  @default(now()) @map("sent_at")

  @@index([earnedIncomeId])
  @@map("payslip_notification")
}

model PayslipAccessToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  earnedIncomeId String       @map("earned_income_id") @db.ObjectId
  earnedIncome   EarnedIncome @relation(fields: [earnedIncomeId], references: [id], onDelete: Cascade)

  channel   PayslipChannel
  recipient String
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  revokedAt DateTime?      @map("revoked_at")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([earnedIncomeId, recipient, channel])
  @@index([expiresAt])
  @@map("payslip_access_token")
}

model EarnedIncomeItemDefinition {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])

  code         String
  name         String
  kind         PayrollItemKind
  displayOrder Int             @default(0) @map("display_order")
  active       Boolean         @default(true)

  values EarnedIncomeItemValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId, kind, active])
  @@map("earned_income_item_definition")
}

model EarnedIncomeItemValue {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  earnedIncomeId String       @map("earned_income_id") @db.ObjectId
  earnedIncome   EarnedIncome @relation(fields: [earnedIncomeId], references: [id])

  itemDefinitionId String                     @map("item_definition_id") @db.ObjectId
  itemDefinition   EarnedIncomeItemDefinition @relation(fields: [itemDefinitionId], references: [id])

  amount Float

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([earnedIncomeId, itemDefinitionId])
  @@index([itemDefinitionId])
  @@map("earned_income_item_value")
}

/**
 * ---------------------------
 * 사업소득
 * ---------------------------
 */

model BusinessIncome {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  uploadId String @db.ObjectId
  upload   Upload @relation(fields: [uploadId], references: [id])

  excelNo      Int?   @map("NO")
  employeeCode String @map("코드")
  employeeName String @map("성   명")

  accrualYm Int @map("귀속년월")
  paymentYm Int @map("지급년월")

  grossPayment Float @map("지급액")

  incomeTax      Float @map("소득세")
  localIncomeTax Float @map("지방소득세")
  expenseArtSpec Float @map("예술/특고인 경비")
  employmentIns  Float @map("고용보험료")
  studentLoan    Float @map("학자금상환액")
