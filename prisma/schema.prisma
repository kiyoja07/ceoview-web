// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma-client"
}

datasource db {
  provider = "mysql"
}

enum BusinessType {
  INDIVIDUAL
  CORPORATION
}

enum PayrollItemKind {
  PAYMENT
  DEDUCTION
}

enum CustomerLinkStatus {
  ACTIVE
  INACTIVE
}

enum LoginProvider {
  LOCAL
  GOOGLE
  KAKAO
  NAVER
  APPLE
}

enum UploadType {
  EARNED_INCOME // 근로소득
  BUSINESS_INCOME // 사업소득
  OTHER_INCOME // 기타소득
  OTHER_INCOME_LABOR // 일용소득
}

enum EmployeePublishStatus {
  SAVED
  PUBLISHED
}

enum AgentBillingPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

/**
 * ---------------------------
 * 사용자 및 회사 관련 테이블
 * ---------------------------
 */

//  세무사무소 등 에이전트 회사 : 서비스 제공자
model AgentOrganization {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  organizationNumber String @unique @map("organization_number") @db.Char(10) // 숫자만 10자리 저장

  businessType BusinessType @map("business_type") // 개인/법인 구분

  organizationName   String?   @map("organization_name") @db.VarChar(200)
  representativeName String?   @map("representative_name") @db.VarChar(100)
  openingDate        DateTime? @map("opening_date") @db.Date
  address            String?   @map("address") @db.VarChar(255)

  users                AgentUser[]
  billing              AgentOrganizationBilling?
  inviteTokens         AgentUserInviteToken[]
  companyLinks         AgentOrganizationCompany[]
  transferRequestsFrom AgentOrganizationCompanyTransferRequest[] @relation("TransferFromOrganization")
  transferRequestsTo   AgentOrganizationCompanyTransferRequest[] @relation("TransferToOrganization")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_organization")
}

// 에이전트의 고객 회사 : 서비스 수혜자
model Company {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  businessNumber String @unique @map("business_number") @db.Char(10) // 숫자만 10자리 저장

  businessType BusinessType @map("business_type") // 개인/법인 구분

  businessName       String?   @map("business_name") @db.VarChar(200)
  representativeName String?   @map("representative_name") @db.VarChar(100)
  openingDate        DateTime? @map("opening_date") @db.Date
  zipcode            String?   @map("zipcode") @db.VarChar(10)
  address            String?   @map("address") @db.VarChar(255)
  addressDetail      String?   @map("address_detail") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  uploads                     Upload[]
  activeUploads               CompanyActiveUpload[]
  earnedIncomeItemDefinitions EarnedIncomeItemDefinition[]
  companyUsers                CompanyUser[]
  companyUserInviteHistories  CompanyUserInviteHistory[]
  employees                   Employee[]
  businessIncomeEmployees     BusinessIncomeEmployee[]
  otherIncomeEmployees        OtherIncomeEmployee[]
  otherIncomeLaborEmployees   OtherIncomeLaborEmployee[]
  organizationLink            AgentOrganizationCompany?
  transferRequest             AgentOrganizationCompanyTransferRequest?

  @@map("company")
}

model AgentOrganizationCompany {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  agentOrganizationId BigInt            @map("agent_organization_id") @db.UnsignedBigInt
  agentOrganization   AgentOrganization @relation(fields: [agentOrganizationId], references: [id], onDelete: Cascade)

  companyId BigInt  @unique @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([agentOrganizationId, companyId])
  @@map("agent_organization_company")
}

model AgentOrganizationCompanyTransferRequest {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyId BigInt  @unique @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fromAgentOrganizationId BigInt?            @map("from_agent_organization_id") @db.UnsignedBigInt
  fromAgentOrganization   AgentOrganization? @relation("TransferFromOrganization", fields: [fromAgentOrganizationId], references: [id], onDelete: SetNull)

  toAgentOrganizationId BigInt            @map("to_agent_organization_id") @db.UnsignedBigInt
  toAgentOrganization   AgentOrganization @relation("TransferToOrganization", fields: [toAgentOrganizationId], references: [id], onDelete: Cascade)

  requestedByAgentUserId BigInt    @map("requested_by_agent_user_id") @db.UnsignedBigInt
  requestedByAgentUser   AgentUser @relation(fields: [requestedByAgentUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([toAgentOrganizationId])
  @@index([fromAgentOrganizationId])
  @@index([requestedByAgentUserId])
  @@map("agent_organization_company_transfer_request")
}

// 에이전트 회사 소속 사용자
model AgentUser {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  agentOrganizationId BigInt?            @map("agent_organization_id") @db.UnsignedBigInt
  agentOrganization   AgentOrganization? @relation(fields: [agentOrganizationId], references: [id])

  email          String        @unique @db.VarChar(255)
  passwordHash   String?       @map("password_hash") @db.VarChar(255)
  loginProvider  LoginProvider @default(LOCAL) @map("login_provider")
  providerUserId String?       @map("provider_user_id") @db.VarChar(191)
  name           String        @db.VarChar(100)
  phone          String?       @db.VarChar(30)
  isMaster       Boolean       @default(false) @map("is_master")
  isActive       Boolean       @default(true) @map("is_active")

  customerLinks          AgentCompanyCustomer[]
  magicLinkTokens        AgentMagicLinkToken[]
  sentInviteTokens       AgentUserInviteToken[]                    @relation("InviterUserInviteTokens")
  sentCompanyUserInvites CompanyUserInviteHistory[]
  transferRequests       AgentOrganizationCompanyTransferRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loginProvider, providerUserId])
  @@index([agentOrganizationId, isActive])
  @@map("agent_user")
}

// 에이전트 사용자용 매직링크 토큰
model AgentMagicLinkToken {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  agentUserId BigInt    @map("agent_user_id") @db.UnsignedBigInt
  agentUser   AgentUser @relation(fields: [agentUserId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentUserId, expiresAt])
  @@index([expiresAt])
  @@map("agent_magic_link_token")
}

// 에이전트 사용자 초대 토큰 (이메일 기반)
model AgentUserInviteToken {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  agentOrganizationId BigInt            @map("agent_organization_id") @db.UnsignedBigInt
  agentOrganization   AgentOrganization @relation(fields: [agentOrganizationId], references: [id], onDelete: Cascade)

  inviterUserId BigInt    @map("inviter_user_id") @db.UnsignedBigInt
  inviterUser   AgentUser @relation("InviterUserInviteTokens", fields: [inviterUserId], references: [id], onDelete: Cascade)

  invitedEmail String @map("invited_email") @db.VarChar(255)

  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  acceptedAgentUserId BigInt? @map("accepted_agent_user_id") @db.UnsignedBigInt

  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentOrganizationId, invitedEmail, expiresAt])
  @@index([inviterUserId, createdAt])
  @@index([expiresAt])
  @@map("agent_user_invite_token")
}

// 고객 회사 소속 사용자
model CompanyUser {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyId BigInt  @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id])

  email          String        @unique @db.VarChar(255)
  passwordHash   String?       @map("password_hash") @db.VarChar(255)
  loginProvider  LoginProvider @default(LOCAL) @map("login_provider")
  providerUserId String?       @map("provider_user_id") @db.VarChar(191)
  name           String        @db.VarChar(100)
  phone          String?       @db.VarChar(30)
  birthday       DateTime?     @map("birthday") @db.Date
  gender         String?       @map("gender") @db.VarChar(10)
  isMaster       Boolean       @default(false) @map("is_master")
  isActive       Boolean       @default(true) @map("is_active")

  agentLinks             AgentCompanyCustomer[]
  magicLinkTokens        CompanyMagicLinkToken[]
  phoneVerificationCodes PhoneVerificationCode[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([loginProvider, providerUserId])
  @@index([companyId])
  @@map("company_user")
}

// 고객 회사 사용자용 매직링크 토큰
model CompanyMagicLinkToken {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyUserId BigInt      @map("company_user_id") @db.UnsignedBigInt
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyUserId, expiresAt])
  @@index([expiresAt])
  @@map("company_magic_link_token")
}

// 휴대폰 인증 코드
model PhoneVerificationCode {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyUserId BigInt      @map("company_user_id") @db.UnsignedBigInt
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  phone      String    @db.VarChar(30)
  code       String    @db.VarChar(6)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyUserId, phone, expiresAt])
  @@index([expiresAt])
  @@map("phone_verification_code")
}

// 거래처 사용자 초대 이력
model CompanyUserInviteHistory {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyId BigInt  @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inviterAgentUserId BigInt    @map("inviter_agent_user_id") @db.UnsignedBigInt
  inviterAgentUser   AgentUser @relation(fields: [inviterAgentUserId], references: [id], onDelete: Cascade)

  contactType String @map("contact_type") @db.VarChar(10) // "email" | "phone"
  contact     String @db.VarChar(255)
  role        String @default("master") @db.VarChar(20)

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([inviterAgentUserId])
  @@map("company_user_invite_history")
}

model AgentCompanyCustomer {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  agentUserId BigInt    @map("agent_user_id") @db.UnsignedBigInt
  agentUser   AgentUser @relation(fields: [agentUserId], references: [id])

  companyUserId BigInt      @map("company_user_id") @db.UnsignedBigInt
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id])

  status          CustomerLinkStatus @default(ACTIVE)
  contractStartAt DateTime?          @map("contract_start_at") @db.Date
  contractEndAt   DateTime?          @map("contract_end_at") @db.Date
  memo            String?            @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([agentUserId, companyUserId])
  @@index([companyUserId, status])
  @@map("agent_company_customer")
}

model AgentOrganizationBilling {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  agentOrganizationId BigInt            @unique @map("agent_organization_id") @db.UnsignedBigInt
  agentOrganization   AgentOrganization @relation(fields: [agentOrganizationId], references: [id])

  plan AgentBillingPlan @default(STARTER) @map("plan")

  cardBrand        String?   @map("card_brand") @db.VarChar(30)
  cardLast4        String?   @map("card_last4") @db.Char(4)
  cardExpMonth     Int?      @map("card_exp_month") @db.UnsignedTinyInt
  cardExpYear      Int?      @map("card_exp_year") @db.UnsignedSmallInt
  cardHolderName   String?   @map("card_holder_name") @db.VarChar(100)
  billingKey       String?   @map("billing_key") @db.VarChar(191)
  cardRegisteredAt DateTime? @map("card_registered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agent_organization_billing")
}

/**
 * ---------------------------
 * 위하고 엑셀 파일 관련 테이블
 * ---------------------------
 */

model Upload {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyId BigInt  @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id])

  type UploadType @map("type")

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  fileName   String?  @map("file_name") @db.VarChar(255)
  checksum   String?  @map("checksum") @db.VarChar(64)
  memo       String?  @map("memo") @db.VarChar(255)

  // row relations (타입별 row 테이블)
  earnedRows     EarnedIncome[]
  businessRows   BusinessIncome[]
  otherRows      OtherIncome[]
  dailyLaborRows DailyIncomeLabor[]

  activePointer CompanyActiveUpload?

  // 동일 파일 중복 업로드 감지(선택): 같은 사업자+타입+체크섬은 중복 방지 가능
  @@unique([companyId, type, checksum])
  // 조회 최적화
  @@index([companyId, type, uploadedAt])
  @@map("upload")
}

// "현재 적용 배치"를 강제하는 포인터 테이블
// 사업자+타입당 1개만 존재하도록 UNIQUE로 강제됨
model CompanyActiveUpload {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyId BigInt  @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id])

  type UploadType @map("type")

  uploadId BigInt @unique @db.UnsignedBigInt
  upload   Upload @relation(fields: [uploadId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([companyId, type])
  @@map("workplace_active_upload")
}

/**
 * ---------------------------
 * 근로소득
 * ---------------------------
 */

model EarnedIncome {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  uploadId BigInt @db.UnsignedBigInt
  upload   Upload @relation(fields: [uploadId], references: [id])

  accrualYm Int      @map("귀속년월")
  paymentYm Int      @map("지급년월")
  payDate   DateTime @map("지급일") @db.Date

  employeeId BigInt?   @map("employee_id") @db.UnsignedBigInt
  employee   Employee? @relation(fields: [employeeId], references: [id])

  employeeCode String  @map("사원코드") @db.VarChar(50)
  employeeName String  @map("사원명") @db.VarChar(100)
  department   String? @map("부서") @db.VarChar(50)
  position     String? @map("직급") @db.VarChar(50)
  jobType      String? @map("직종") @db.VarChar(50)

  baseSalary    Decimal @map("수당_기본급") @db.Decimal(15, 2)
  bonus         Decimal @map("상여") @db.Decimal(15, 2)
  mealAllowance Decimal @map("식대") @db.Decimal(15, 2)
  allowance     Decimal @map("수당") @db.Decimal(15, 2)
  travelExpense Decimal @map("출장비") @db.Decimal(15, 2)
  totalPayment  Decimal @map("지급액계") @db.Decimal(15, 2)

  nationalPensionDeduction Decimal @map("공제_국민연금") @db.Decimal(15, 2)
  healthInsurance          Decimal @map("건강보험") @db.Decimal(15, 2)
  employmentInsurance      Decimal @map("고용보험") @db.Decimal(15, 2)
  longTermCareInsurance    Decimal @map("장기요양보험료") @db.Decimal(15, 2)
  incomeTax                Decimal @map("소득세") @db.Decimal(15, 2)
  localIncomeTax           Decimal @map("지방소득세") @db.Decimal(15, 2)
  healthInsuranceAdj       Decimal @map("건강보험정산") @db.Decimal(15, 2)
  nationalPensionAdj       Decimal @map("국민연금정산") @db.Decimal(15, 2)
  employmentInsuranceAdj   Decimal @map("고용보험정산") @db.Decimal(15, 2)
  longTermCareAdj          Decimal @map("장기요양정산") @db.Decimal(15, 2)
  prepaidIncomeTax         Decimal @map("기납부소득세") @db.Decimal(15, 2)
  prepaidLocalIncomeTax    Decimal @map("기납부지방소득세") @db.Decimal(15, 2)
  addlIncomeTaxAdj         Decimal @map("추가정산소득세") @db.Decimal(15, 2)
  addlLocalIncomeTaxAdj    Decimal @map("추가정산지방소득세") @db.Decimal(15, 2)
  totalDeduction           Decimal @map("공제액계") @db.Decimal(15, 2)

  netPayment Decimal @map("차인지급액") @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemValues           EarnedIncomeItemValue[]
  payslipNotifications PayslipNotification[]
  payslipAccessTokens  PayslipAccessToken[]

  @@unique([uploadId, employeeCode, accrualYm, paymentYm, payDate])
  @@index([employeeCode, accrualYm, paymentYm, payDate])
  @@index([employeeId])
  @@map("earned_income")
}

enum PayslipChannel {
  EMAIL
  SMS
  KAKAO
}

enum PayslipNotificationStatus {
  SENT
  FAILED
}

model PayslipNotification {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  earnedIncomeId BigInt       @map("earned_income_id") @db.UnsignedBigInt
  earnedIncome   EarnedIncome @relation(fields: [earnedIncomeId], references: [id], onDelete: Cascade)

  channel      PayslipChannel
  recipient    String                   @db.VarChar(255)
  status       PayslipNotificationStatus @default(SENT)
  errorMessage String?                  @map("error_message") @db.VarChar(500)
  sentAt       DateTime                 @default(now()) @map("sent_at")

  @@index([earnedIncomeId])
  @@map("payslip_notification")
}

model PayslipAccessToken {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  earnedIncomeId BigInt       @map("earned_income_id") @db.UnsignedBigInt
  earnedIncome   EarnedIncome @relation(fields: [earnedIncomeId], references: [id], onDelete: Cascade)

  channel   PayslipChannel
  recipient String    @db.VarChar(255)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([earnedIncomeId, recipient, channel])
  @@index([expiresAt])
  @@map("payslip_access_token")
}

model EarnedIncomeItemDefinition {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  companyId BigInt  @map("company_id") @db.UnsignedBigInt
  company   Company @relation(fields: [companyId], references: [id])

  code         String          @db.VarChar(100)
  name         String          @db.VarChar(100)
  kind         PayrollItemKind
  displayOrder Int             @default(0) @map("display_order")
  active       Boolean         @default(true)

  values EarnedIncomeItemValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId, kind, active])
  @@map("earned_income_item_definition")
}

model EarnedIncomeItemValue {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  earnedIncomeId BigInt       @map("earned_income_id") @db.UnsignedBigInt
  earnedIncome   EarnedIncome @relation(fields: [earnedIncomeId], references: [id])

  itemDefinitionId BigInt                     @map("item_definition_id") @db.UnsignedBigInt
  itemDefinition   EarnedIncomeItemDefinition @relation(fields: [itemDefinitionId], references: [id])

  amount Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([earnedIncomeId, itemDefinitionId])
  @@index([itemDefinitionId])
  @@map("earned_income_item_value")
}

/**
 * ---------------------------
 * 사업소득
 * ---------------------------
 */

model BusinessIncome {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  uploadId BigInt @db.UnsignedBigInt
  upload   Upload @relation(fields: [uploadId], references: [id])

  excelNo      Int?   @map("NO")
  employeeCode String @map("코드") @db.VarChar(50)
  employeeName String @map("성   명") @db.VarChar(100)

  accrualYm Int @map("귀속년월")
  paymentYm Int @map("지급년월")

  grossPayment Decimal @map("지급액") @db.Decimal(15, 2)

  incomeTax      Decimal @map("소득세") @db.Decimal(15, 2)
  localIncomeTax Decimal @map("지방소득세") @db.Decimal(15, 2)
  expenseArtSpec Decimal @map("예술/특고인 경비") @db.Decimal(15, 2)
  employmentIns  Decimal @map("고용보험료") @db.Decimal(15, 2)
  studentLoan    Decimal @map("학자금상환액") @db.Decimal(15, 2)
  industrialAcc  Decimal @map("산재보험료") @db.Decimal(15, 2)

  netPayment Decimal @map("차인지급액") @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([uploadId, employeeCode, accrualYm, paymentYm])
  @@index([employeeCode, accrualYm, paymentYm])
  @@map("business_income")
}

/**
 * ---------------------------
 * 기타소득
 * ---------------------------
 */

model OtherIncome {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  uploadId BigInt @db.UnsignedBigInt
  upload   Upload @relation(fields: [uploadId], references: [id])

  excelNo      Int?   @map("NO")
  employeeCode String @map("코드") @db.VarChar(50)
  employeeName String @map("성   명") @db.VarChar(100)

  incomeType String @map("소득구분") @db.VarChar(50)

  accrualYm Int @map("귀속년월")
  paymentYm Int @map("지급년월")

  grossPayment   Decimal @map("지급액") @db.Decimal(15, 2)
  taxCorpTax     Decimal @map("소득세/법인세") @db.Decimal(15, 2)
  localIncomeTax Decimal @map("지방소득세") @db.Decimal(15, 2)

  netPayment Decimal @map("차인지급액") @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([uploadId, employeeCode, incomeType, accrualYm, paymentYm])
  @@index([employeeCode, incomeType, accrualYm, paymentYm])
  @@map("other_income")
}

