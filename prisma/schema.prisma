/**
 * ---------------------------
 * 직원 관리
 * ---------------------------
 */

model Employee {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  companyId String  @map("company_id") @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeCode    String? @map("employee_code")
  name            String
  residentNumber  String? @map("resident_number")
  nationalityType String? @map("nationality_type") // 내·외국인
  jobCategory     String? @map("job_category") // 직종구분
  residenceType   String? @map("residence_type") // 거주구분
  department      String? @map("department") // 부서
  positionTitle   String? @map("position_title") // 직책명
  email           String?
  phone           String? // 휴대폰
  landlinePhone   String? @map("landline_phone") // 전화번호
  hireDate        String? @map("hire_date")
  resignDate      String? @map("resign_date")
  zipcode         String? @map("zipcode")
  address         String? @map("address")
  addressDetail   String? @map("address_detail")

  // 부양가족 공제
  hasSpouse        String? @map("has_spouse") // 배우자 유무
  dependentUnder20 String? @map("dependent_under_20") // 부양가족공제_20세이하
  dependentOver60  String? @map("dependent_over_60") // 부양가족공제_60세이상

  // 추가 공제
  deductionSenior        String? @map("deduction_senior") // 추가공제_경로우대
  deductionDisabled      String? @map("deduction_disabled") // 추가공제_장애인
  deductionWomen         String? @map("deduction_women") // 추가공제_부녀자
  deductionChildren      String? @map("deduction_children") // 추가공제_자녀
  deductionBirthAdoption String? @map("deduction_birth_adoption") // 추가공제_출산입양
  deductionSingleParent  String? @map("deduction_single_parent") // 추가공제_한부모

  // 보험/호봉
  employmentInsurance String? @map("employment_insurance") // 고용보험
  payGrade            String? @map("pay_grade") // 호봉
  nationalPension     String? @map("national_pension") // 국민연금
  healthInsurance     String? @map("health_insurance") // 건강보험

  publishStatus EmployeePublishStatus @default(SAVED) @map("publish_status")

  bankAccounts  EmployeeBankAccount[]
  earnedIncomes EarnedIncome[]
  user          EmployeeUser?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([companyId, employeeCode])
  @@index([companyId, name])
  @@index([companyId, deletedAt, createdAt])
  @@index([companyId, publishStatus, deletedAt])
  @@map("employee")
}

model EmployeeUser {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  employeeId String   @unique @map("employee_id") @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  email         String? @unique
  phone         String? @unique
  name          String
  zipcode       String? @map("zipcode")
  address       String? @map("address")
  addressDetail String? @map("address_detail")

  isActive Boolean @default(true) @map("is_active")

  magicLinkTokens EmployeeMagicLinkToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("employee_user")
}

model EmployeeMagicLinkToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  employeeUserId String       @map("employee_user_id") @db.ObjectId
  employeeUser   EmployeeUser @relation(fields: [employeeUserId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employeeUserId, expiresAt])
  @@index([expiresAt])
  @@map("employee_magic_link_token")
}

