{
  "name": "ceoview-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && doppler run -- next dev",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "prestart": "rm -rf .next && doppler run -- npm run build",
    "start": "doppler run -- next start",
    "clean": "npm cache clean --force && rm -rf node_modules package-lock.json .next"
  },
  "dependencies": {
    "html2canvas-pro": "^1.6.7",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
